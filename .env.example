# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/semantic_code

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=code_embeddings

# Defaults (configurable via UI — only needed if you want env-based defaults)
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini

# Directory browser root (inside the container). In Docker, this corresponds to
# the host folder you mount. For local dev outside Docker, use an absolute path
# or "/" to browse the whole machine.
BROWSE_ROOT=/host/users

# Host folder mounted into the backend container for indexing (Docker only)
# HOST_USER_DIR=C:/Users/You
# HOST_MOUNT_PATH=/host/users

LOG_LEVEL=INFO
